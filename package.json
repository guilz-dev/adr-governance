{
  "name": "@guilz-dev/adr-governance",
  "version": "0.1.11",
  "description": "Multi-runtime ADR governance — Skill, CLI, and hooks for Cursor, Claude Code, Codex CLI, and Gemini CLI.",
  "type": "module",
  "license": "MIT",
  "author": "guilz-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilz-dev/adr-governance.git"
  },
  "homepage": "https://github.com/guilz-dev/adr-governance#readme",
  "bugs": {
    "url": "https://github.com/guilz-dev/adr-governance/issues"
  },
  "keywords": [
    "adr",
    "architecture-decision-record",
    "agent-skills",
    "hooks",
    "cursor",
    "claude-code",
    "codex",
    "gemini-cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "bin": {
    "adr-governance": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "skill",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-bundles.mjs",
    "lint": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "esbuild": "0.25.5",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
